      "translations": {
        "da": {
          "heading": null,
          "body": "Hvis du støder på problemer af nogen art, kan du kontakte vores supportteam når som helst og hvor som helst.",
          "bodyHtml": "<p>Hvis du støder på problemer af nogen art, kan du kontakte vores supportteam når som helst og hvor som helst.</p>",
          "listItems": [],
          "links": [],
          "ctaLabel": null,
          "ctaUrl": null,
          "imageAlts": []
        },
        "en": {
          "heading": null,
          "body": "If you face any type of problem, reach out to our support team anytime from anywhere.",
          "bodyHtml": "<p>If you face any type of problem, reach out to our support team anytime from anywhere.</p>",
          "listItems": [],
          "links": [],
          "ctaLabel": null,
          "ctaUrl": null,
          "imageAlts": []
        },
        "de": {
          "heading": null,
          "body": "Sollten Sie auf irgendein Problem stoßen, können Sie sich jederzeit und von überall an unser Support-Team wenden.",
          "bodyHtml": "<p>Sollten Sie auf irgendein Problem stoßen, können Sie sich jederzeit und von überall an unser Support-Team wenden.</p>",
          "listItems": [],
          "links": [],
          "ctaLabel": null,
          "ctaUrl": null,
          "imageAlts": []
        },
        "fr": {
          "heading": null,
          "body": "Si vous rencontrez le moindre problème, n’hésitez pas à contacter notre équipe d’assistance à tout moment et de n’importe où.",
          "bodyHtml": "<p>Si vous rencontrez le moindre problème, n’hésitez pas à contacter notre équipe d’assistance à tout moment et de n’importe où.</p>",
          "listItems": [],
          "links": [],
          "ctaLabel": null,
          "ctaUrl": null,
          "imageAlts": []
        },
        "nl": {
          "heading": null,
          "body": "Als u problemen ondervindt, kunt u op elk moment en vanaf elke locatie contact opnemen met ons ondersteuningsteam.",
          "bodyHtml": "<p>Als u problemen ondervindt, kunt u op elk moment en vanaf elke locatie contact opnemen met ons ondersteuningsteam.</p>",
          "listItems": [],
          "links": [],
          "ctaLabel": null,
          "ctaUrl": null,
          "imageAlts": []
        },
        "nb": {
          "heading": null,
          "body": "Hvis du støter på noen form for problem, kan du kontakte supportteamet vårt når som helst og hvor som helst.",
          "bodyHtml": "<p>Hvis du støter på noen form for problem, kan du kontakte supportteamet vårt når som helst og hvor som helst.</p>",
          "listItems": [],
          "links": [],
          "ctaLabel": null,
          "ctaUrl": null,
          "imageAlts": []
        },
        "sv": {
          "heading": null,
          "body": "Om du stöter på någon form av problem kan du kontakta vårt supportteam när som helst och var som helst.",
          "bodyHtml": "<p>Om du stöter på någon form av problem kan du kontakta vårt supportteam när som helst och var som helst.</p>",
          "listItems": [],
          "links": [],
          "ctaLabel": null,
          "ctaUrl": null,
          "imageAlts": []
        },
        "tr": {
          "heading": null,
          "body": "Herhangi bir sorunla karşılaşırsanız, dilediğiniz zaman ve dilediğiniz yerden destek ekibimizle iletişime geçebilirsiniz.",
          "bodyHtml": "<p>Herhangi bir sorunla karşılaşırsanız, dilediğiniz zaman ve dilediğiniz yerden destek ekibimizle iletişime geçebilirsiniz.</p>",
          "listItems": [],
          "links": [],
          "ctaLabel": null,
          "ctaUrl": null,
          "imageAlts": []
        }
      }
